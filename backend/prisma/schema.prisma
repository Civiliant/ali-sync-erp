generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  username     String    @unique @db.VarChar(64)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  email        String?   @db.VarChar(128)
  phone        String?   @db.VarChar(32)
  realName     String?   @map("real_name") @db.VarChar(64)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(512)
  deptId       BigInt?   @map("dept_id") @db.BigInt
  status       Int       @default(1) @db.SmallInt
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("users")
}

model Department {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  parentId  BigInt?  @map("parent_id") @db.BigInt
  name      String   @db.VarChar(64)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("departments")
}

model Role {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(64)
  description String?  @db.VarChar(255)
  isBuiltin   Boolean  @default(false) @map("is_builtin")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("roles")
}

model Permission {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  code      String   @unique @db.VarChar(128)
  name      String   @db.VarChar(128)
  module    String   @db.VarChar(64)
  menuId    BigInt?  @map("menu_id") @db.BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("permissions")
}

model UserRole {
  userId BigInt @map("user_id") @db.BigInt
  roleId BigInt @map("role_id") @db.BigInt

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       BigInt @map("role_id") @db.BigInt
  permissionId BigInt @map("permission_id") @db.BigInt

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Menu {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  parentId  BigInt?  @map("parent_id") @db.BigInt
  name      String   @db.VarChar(64)
  path      String?  @db.VarChar(255)
  component String?  @db.VarChar(255)
  icon      String?  @db.VarChar(64)
  sortOrder Int      @default(0) @map("sort_order")
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("menus")
}

model LoginLog {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  userId    BigInt?  @map("user_id") @db.BigInt
  username  String?  @db.VarChar(64)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  status    String   @db.VarChar(16)
  message   String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("login_logs")
}

model Store {
  id                    BigInt    @id @default(autoincrement()) @db.BigInt
  name                  String    @db.VarChar(128)
  platform              String    @default("alibaba_intl") @db.VarChar(32)
  accountId             String?   @map("account_id") @db.VarChar(128)
  appKey                String    @map("app_key") @db.VarChar(128)
  appSecretEnc          String    @map("app_secret_enc") @db.Text
  accessTokenEnc        String?   @map("access_token_enc") @db.Text
  refreshTokenEnc       String?   @map("refresh_token_enc") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  authStatus            String    @default("PENDING") @map("auth_status") @db.VarChar(32)
  status                Int       @default(1) @db.SmallInt
  syncEnabled           Boolean   @default(true) @map("sync_enabled")
  lastOrderSyncAt       DateTime? @map("last_order_sync_at") @db.Timestamptz(6)
  lastProductSyncAt     DateTime? @map("last_product_sync_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([platform, status], map: "idx_stores_platform")
  @@map("stores")
}

model PlatformAccount {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  storeId     BigInt   @map("store_id") @db.BigInt
  accountId   String   @map("account_id") @db.VarChar(128)
  name        String?  @db.VarChar(128)
  role        String?  @db.VarChar(64)
  status      String   @default("active") @db.VarChar(32)
  platformRaw Json?    @map("platform_raw")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([storeId, accountId], map: "uq_platform_accounts")
  @@map("platform_accounts")
}

model PlatformAccountBinding {
  id                BigInt   @id @default(autoincrement()) @db.BigInt
  storeId           BigInt   @map("store_id") @db.BigInt
  platformAccountId BigInt   @map("platform_account_id") @db.BigInt
  userId            BigInt   @map("user_id") @db.BigInt
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([platformAccountId, userId], map: "uq_account_binding")
  @@index([userId], map: "idx_binding_user")
  @@map("platform_account_bindings")
}

model AlibabaOauthState {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  state     String   @unique @db.VarChar(128)
  storeId   BigInt?  @map("store_id") @db.BigInt
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("alibaba_oauth_states")
}

model AlibabaOauthLog {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  storeId      BigInt?  @map("store_id") @db.BigInt
  action       String   @db.VarChar(32)
  status       String   @db.VarChar(16)
  errorCode    String?  @map("error_code") @db.VarChar(64)
  errorMessage String?  @map("error_message") @db.Text
  ip           String?  @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("alibaba_oauth_logs")
}

model Product {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  storeId      BigInt?   @map("store_id") @db.BigInt
  groupId      BigInt?   @map("group_id") @db.BigInt
  supplierId   BigInt?   @map("supplier_id") @db.BigInt
  title        String?   @db.VarChar(512)
  categoryId   String?   @map("category_id") @db.VarChar(64)
  categoryName String?   @map("category_name") @db.VarChar(255)
  mainImageUrl String?   @map("main_image_url") @db.VarChar(1024)
  tags         Json?
  costPrice    Decimal?  @map("cost_price") @db.Decimal(18, 2)
  currency     String    @default("CNY") @db.VarChar(8)
  status       String    @default("active") @db.VarChar(32)
  platformRaw  Json?     @map("platform_raw")
  syncedAt     DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([storeId], map: "idx_products_store")
  @@index([supplierId], map: "idx_products_supplier")
  @@map("products")
}

model ProductSku {
  id              BigInt    @id @default(autoincrement()) @db.BigInt
  productId       BigInt    @map("product_id") @db.BigInt
  skuCode         String?   @map("sku_code") @db.VarChar(128)
  specAttrs       Json?     @map("spec_attrs")
  costPrice       Decimal?  @map("cost_price") @db.Decimal(18, 2)
  price           Decimal?  @db.Decimal(18, 2)
  currency        String?   @db.VarChar(8)
  localStock      Int       @default(0) @map("local_stock")
  platformStock   Int       @default(0) @map("platform_stock")
  weight          Decimal?  @db.Decimal(12, 3)
  wholesalePrices Json?     @map("wholesale_prices")
  platformRaw     Json?     @map("platform_raw")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([productId, skuCode], map: "uq_skus_product_code")
  @@index([productId], map: "idx_skus_product")
  @@map("product_skus")
}

model ProductImage {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  productId BigInt   @map("product_id") @db.BigInt
  imageUrl  String   @map("image_url") @db.VarChar(1024)
  isMain    Boolean  @default(false) @map("is_main")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId], map: "idx_pimages_product")
  @@map("product_images")
}

model ProductGroup {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  parentId  BigInt?  @map("parent_id") @db.BigInt
  name      String   @db.VarChar(128)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("product_groups")
}

model ProductTag {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  name      String   @unique @db.VarChar(64)
  color     String?  @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("product_tags")
}

model ProductPlatformMapping {
  id                BigInt   @id @default(autoincrement()) @db.BigInt
  storeId           BigInt   @map("store_id") @db.BigInt
  platform          String   @default("alibaba_intl") @db.VarChar(32)
  platformProductId String   @map("platform_product_id") @db.VarChar(128)
  platformSkuId     String?  @map("platform_sku_id") @db.VarChar(128)
  productId         BigInt   @map("product_id") @db.BigInt
  productSkuId      BigInt?  @map("product_sku_id") @db.BigInt
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([storeId, platform, platformProductId, platformSkuId], map: "uq_platform_mapping")
  @@index([productSkuId], map: "idx_mapping_local")
  @@map("product_platform_mappings")
}

model WholesalePrice {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  productSkuId BigInt   @map("product_sku_id") @db.BigInt
  minQty       Int      @map("min_qty")
  maxQty       Int?     @map("max_qty")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(18, 2)
  currency     String   @default("CNY") @db.VarChar(8)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([productSkuId], map: "idx_wholesale_sku")
  @@map("wholesale_prices")
}

model ProductCostHistory {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  productSkuId BigInt   @map("product_sku_id") @db.BigInt
  oldCost      Decimal? @map("old_cost") @db.Decimal(18, 2)
  newCost      Decimal  @map("new_cost") @db.Decimal(18, 2)
  currency     String   @default("CNY") @db.VarChar(8)
  changedBy    BigInt?  @map("changed_by") @db.BigInt
  note         String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("product_cost_history")
}

model Inventory {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  productSkuId BigInt   @map("product_sku_id") @db.BigInt
  storeId      BigInt?  @map("store_id") @db.BigInt
  stockType    String   @map("stock_type") @db.VarChar(16)
  changeType   String   @map("change_type") @db.VarChar(32)
  quantity     Int
  beforeQty    Int      @map("before_qty")
  afterQty     Int      @map("after_qty")
  refType      String?  @map("ref_type") @db.VarChar(32)
  refId        String?  @map("ref_id") @db.VarChar(128)
  note         String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productSkuId, stockType, createdAt(sort: Desc)], map: "idx_inventory_sku")
  @@map("inventory")
}

model Supplier {
  id              BigInt    @id @default(autoincrement()) @db.BigInt
  name            String    @db.VarChar(128)
  contactName     String?   @map("contact_name") @db.VarChar(64)
  phone           String?   @db.VarChar(32)
  wechat          String?   @db.VarChar(64)
  address         String?   @db.VarChar(255)
  settlementCycle String?   @map("settlement_cycle") @db.VarChar(32)
  bankAccount     String?   @map("bank_account") @db.VarChar(64)
  remark          String?   @db.Text
  status          Int       @default(1) @db.SmallInt
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("suppliers")
}

model SupplierProduct {
  supplierId BigInt  @map("supplier_id") @db.BigInt
  productId  BigInt  @map("product_id") @db.BigInt
  isDefault  Boolean @default(false) @map("is_default")

  @@id([supplierId, productId])
  @@map("supplier_products")
}

model Order {
  id                   BigInt    @id @default(autoincrement()) @db.BigInt
  storeId              BigInt    @map("store_id") @db.BigInt
  platform             String    @default("alibaba_intl") @db.VarChar(32)
  platformOrderId      String    @map("platform_order_id") @db.VarChar(128)
  customerId           BigInt?   @map("customer_id") @db.BigInt
  buyerName            String?   @map("buyer_name") @db.VarChar(128)
  buyerEmail           String?   @map("buyer_email") @db.VarChar(128)
  buyerPhone           String?   @map("buyer_phone") @db.VarChar(32)
  orderStatus          String    @default("pending") @map("order_status") @db.VarChar(32)
  platformStatus       String?   @map("platform_status") @db.VarChar(32)
  currency             String?   @db.VarChar(8)
  totalAmount          Decimal?  @map("total_amount") @db.Decimal(18, 2)
  freightAmount        Decimal?  @map("freight_amount") @db.Decimal(18, 2)
  discountAmount       Decimal?  @map("discount_amount") @db.Decimal(18, 2)
  platformFee          Decimal?  @map("platform_fee") @db.Decimal(18, 2)
  paidAmount           Decimal?  @map("paid_amount") @db.Decimal(18, 2)
  lockStatus           String    @default("UNLOCKED") @map("lock_status") @db.VarChar(16)
  exchangeRateSnapshot Decimal?  @map("exchange_rate_snapshot") @db.Decimal(18, 6)
  revenueCny           Decimal?  @map("revenue_cny") @db.Decimal(18, 2)
  lockedAt             DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy             BigInt?   @map("locked_by") @db.BigInt
  orderTime            DateTime? @map("order_time") @db.Timestamptz(6)
  payTime              DateTime? @map("pay_time") @db.Timestamptz(6)
  shipTime             DateTime? @map("ship_time") @db.Timestamptz(6)
  completeTime         DateTime? @map("complete_time") @db.Timestamptz(6)
  logisticsCompany     String?   @map("logistics_company") @db.VarChar(128)
  trackingNo           String?   @map("tracking_no") @db.VarChar(128)
  syncStatus           String    @default("synced") @map("sync_status") @db.VarChar(16)
  remark               String?   @db.Text
  platformRaw          Json?     @map("platform_raw")
  syncedAt             DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([storeId, platformOrderId], map: "uq_orders_store_platform")
  @@index([storeId, orderStatus], map: "idx_orders_store_status")
  @@index([storeId, orderTime(sort: Desc)], map: "idx_orders_store_time")
  @@index([customerId], map: "idx_orders_customer")
  @@map("orders")
}

model OrderItem {
  id                BigInt   @id @default(autoincrement()) @db.BigInt
  orderId           BigInt   @map("order_id") @db.BigInt
  productId         BigInt?  @map("product_id") @db.BigInt
  productSkuId      BigInt?  @map("product_sku_id") @db.BigInt
  platformProductId String?  @map("platform_product_id") @db.VarChar(128)
  platformSkuId     String?  @map("platform_sku_id") @db.VarChar(128)
  skuCode           String?  @map("sku_code") @db.VarChar(128)
  productTitle      String?  @map("product_title") @db.VarChar(512)
  imageUrl          String?  @map("image_url") @db.VarChar(1024)
  specAttrs         Json?    @map("spec_attrs")
  quantity          Int      @default(1)
  unitPrice         Decimal? @map("unit_price") @db.Decimal(18, 2)
  currency          String?  @db.VarChar(8)
  amount            Decimal? @db.Decimal(18, 2)
  platformRaw       Json?    @map("platform_raw")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_items_order")
  @@index([productSkuId], map: "idx_items_sku")
  @@map("order_items")
}

model OrderCost {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  orderId      BigInt   @map("order_id") @db.BigInt
  costType     String   @map("cost_type") @db.VarChar(32)
  amount       Decimal  @db.Decimal(18, 2)
  currency     String   @default("CNY") @db.VarChar(8)
  exchangeRate Decimal  @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  amountCny    Decimal  @map("amount_cny") @db.Decimal(18, 2)
  sourceType   String   @default("manual") @map("source_type") @db.VarChar(16)
  refNo        String?  @map("ref_no") @db.VarChar(128)
  note         String?  @db.Text
  createdBy    BigInt?  @map("created_by") @db.BigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_costs_order")
  @@map("order_costs")
}

model CostType {
  code      String  @id @db.VarChar(32)
  name      String  @db.VarChar(64)
  sortOrder Int     @default(0) @map("sort_order")
  enabled   Boolean @default(true)

  @@map("cost_types")
}

model Shipment {
  id               BigInt    @id @default(autoincrement()) @db.BigInt
  storeId          BigInt    @map("store_id") @db.BigInt
  orderId          BigInt    @map("order_id") @db.BigInt
  logisticsCompany String?   @map("logistics_company") @db.VarChar(128)
  trackingNo       String?   @map("tracking_no") @db.VarChar(128)
  shipStatus       String    @default("pending") @map("ship_status") @db.VarChar(32)
  shipTime         DateTime? @map("ship_time") @db.Timestamptz(6)
  platformRaw      Json?     @map("platform_raw")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_shipments_order")
  @@map("shipments")
}

model ShipmentItem {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  shipmentId  BigInt   @map("shipment_id") @db.BigInt
  orderItemId BigInt   @map("order_item_id") @db.BigInt
  quantity    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([shipmentId], map: "idx_shipitems_shipment")
  @@map("shipment_items")
}

model PurchaseOrder {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  orderId     BigInt?  @map("order_id") @db.BigInt
  supplierId  BigInt?  @map("supplier_id") @db.BigInt
  status      String   @default("draft") @db.VarChar(32)
  totalAmount Decimal? @map("total_amount") @db.Decimal(18, 2)
  currency    String   @default("CNY") @db.VarChar(8)
  remark      String?  @db.Text
  createdBy   BigInt?  @map("created_by") @db.BigInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_purchase_order")
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              BigInt   @id @default(autoincrement()) @db.BigInt
  purchaseOrderId BigInt   @map("purchase_order_id") @db.BigInt
  productSkuId    BigInt   @map("product_sku_id") @db.BigInt
  quantity        Int
  unitPrice       Decimal? @map("unit_price") @db.Decimal(18, 2)
  amount          Decimal? @db.Decimal(18, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([purchaseOrderId], map: "idx_purchase_items")
  @@map("purchase_order_items")
}

model OrderStatusLog {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  orderId    BigInt   @map("order_id") @db.BigInt
  fromStatus String?  @map("from_status") @db.VarChar(32)
  toStatus   String   @map("to_status") @db.VarChar(32)
  operatorId BigInt?  @map("operator_id") @db.BigInt
  remark     String?  @db.VarChar(255)
