# ===== 数据库 =====
DATABASE_URL="postgresql://alisync:alisync@localhost:5432/alisync?schema=public"

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ===== 认证 =====
# JWT 密钥（随机长字符串，勿泄露）
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=604800

# ===== 凭证加密（独立密钥，禁止复用 JWT_SECRET）=====
APP_ENCRYPTION_KEY=change-me-32-byte-encryption-key

# ===== 阿里国际站开放平台 =====
# 申请应用后从开放平台控制台获取
ALI_INTL_APP_KEY=your_app_key
ALI_INTL_APP_SECRET=your_app_secret
ALI_INTL_REDIRECT_URI=https://你的域名/api/stores/oauth/callback
ALI_INTL_AUTH_URL=https://oauth.alibaba.com/authorize
ALI_INTL_TOKEN_URL=https://oauth.alibaba.com/token
# API 网关地址（申请应用后从控制台拿）
ALI_INTL_GATEWAY_URL=https://gw.api.alibaba.com

# ===== Worm 打印渲染微服务 =====
WORM_RENDER_URL=http://worm-render:3001
WORM_RENDER_API_KEY=change-me-render-api-key

# ===== 云存储 OSS =====
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ===== 服务端口 =====
BACKEND_PORT=3000
FRONTEND_PORT=5173
